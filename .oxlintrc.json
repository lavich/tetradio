{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "off",
    "pedantic": "off"
  },
  "rules": {
    "typescript/no-misused-spread": "off",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    "dist-course",
    "public/content",
    "docs/art-sheet.html",
    ".vitest",
    "test-results",
    "playwright-report",
    ".agents",
    "docs/audit",
    "docs/design",
    ".impeccable",
    ".claude"
  ]
}
