{
  "name": "greek-a2-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "predev": "npm run content",
    "dev:mock": "VITE_TELEGRAM_MOCK=1 vite --host 0.0.0.0",
    "predev:mock": "npm run content",
    "content": "node content/build.ts",
    "prebuild": "npm run content",
    "build": "tsc -b && vite build",
    "check:bundle": "node scripts/check-bundle.ts",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "spec": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "spec:validate": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "spec:status": "OPENSPEC_TELEMETRY=0 openspec status --change course-progress-sync",
    "openspec": "openspec",
    "lexicon:check": "node scripts/check-lexicon.ts",
    "test:e2e:course": "playwright test -c playwright.course.config.ts",
    "lexicon:content": "node scripts/lexicon-to-content.ts",
    "pictures:sync": "node scripts/pictures-sync.ts",
    "lexicon:sync": "node scripts/lexicon-sync.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@sentry/react": "^10.75.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dexie": "^4.4.6",
    "dexie-export-import": "^4.4.1",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.46.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "ts-fsrs": "^5.4.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.2",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.84.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "description": "Greek A2 course and learning application Telegram Mini App",
  "engines": {
    "node": ">=20.19.0"
  }
}
